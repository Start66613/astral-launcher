{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astral",
  "version": "0.1.0",
  "identifier": "com.astral.launcher",
  "build": {
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astral",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
